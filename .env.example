# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
# Local development and tests: leave DATABASE_URL unset and use these.
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Hosting (Neon, Render, etc.): set this instead. When it is set the PG*
# vars above are ignored and the connection uses SSL.
# DATABASE_URL=

# --- App ---
# Generate a long random value. Use a different one in production.
JWT_SECRET=
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Must be exactly "production" in production, or error responses
# will include stack traces.
NODE_ENV=development
PORT=5000

# --- docker-compose.yml only ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
