{
  "name": "logiikkateht-v-t",
  "version": "1.0.0",
  "description": "backend/node_modules/\r frontend/node_modules/",
  "main": "index.js",
  "scripts": {
    "docker:up": "docker compose up -d",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "dev": "npm run docker:up && concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "npm --prefix backend test",
    "test:routes": "npm --prefix backend run test:routes",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuomasHirv/LogiikkaTeht-v-t.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/TuomasHirv/LogiikkaTeht-v-t/issues"
  },
  "homepage": "https://github.com/TuomasHirv/LogiikkaTeht-v-t#readme",
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "react-router-dom": "^7.18.0"
  }
}
